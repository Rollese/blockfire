# Dedicated server image (STUB — validated in M8).
# Assumes a headless Linux export at build/server/blockfire_server[.x86_64].
FROM debian:bookworm-slim

# Godot headless exports need a few runtime libs even without a display.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libfreetype6 ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY build/server/ /app/
RUN chmod +x /app/blockfire_server* || true

ENV PORT=27015
EXPOSE 27015/udp

# --headless keeps it renderless; role flag selects the dedicated server.
ENTRYPOINT ["sh", "-c", "/app/blockfire_server --headless -- --server --port=${PORT}"]
