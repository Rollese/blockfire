      "Bash(git diff:*)", "Bash(git show:*)", "Bash(git rev-parse:*)", "Bash(git branch:*)",
      "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git merge:*)", "Bash(git stash:*)",
      "Bash(git push:*)", "Bash(git pull:*)", "Bash(git fetch:*)", "Bash(git restore:*)",
      "Bash(bash ci/:*)", "Bash(./ci/:*)", "Bash(bash docker/:*)", "Bash(./docker/:*)",
      "Bash(chmod:*)", "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)",
      "Bash(cat:*)", "Bash(ls:*)", "Bash(grep:*)", "Bash(rg:*)", "Bash(find:*)",
      "Bash(tail:*)", "Bash(head:*)", "Bash(echo:*)", "Bash(wc:*)", "Bash(sed:*)",
      "Bash(docker:*)", "Bash(docker compose:*)", "Bash(graphify:*)"
