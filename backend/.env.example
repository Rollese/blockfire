# Copy to .env for local runs; docker-compose reads these.
DATABASE_URL=postgresql+asyncpg://blockfire:blockfire@db:5432/blockfire_stats
INGEST_TOKEN=change-me-in-prod
RAW_EVENT_RETENTION_DAYS=90

# Steam Web API key for player-profile enrichment (persona name/avatar).
# Leave blank to disable: enrichment is a no-op when unset.
STEAM_WEB_API_KEY=

# Secret used to sign session cookies. CHANGE IN PROD.
SESSION_SECRET=dev-insecure-change-me

# Public base URL of the site; used for the Steam OpenID realm and return_to.
SITE_BASE_URL=http://localhost:8000

# Comma/space-separated list of admin SteamID64s allowed into admin routes.
# Leave blank to disable admin access entirely.
ADMIN_STEAM_IDS=

# When true, admin routes are open WITHOUT Steam auth.
# dev/LAN only — MUST stay false (or unset) in any internet-facing deploy.
ADMIN_DEV_OPEN=false

# --- P4 anomaly-detection thresholds (tuning knobs) ---
# Absolute floors that flag a player as an outlier on each metric.
ANOMALY_KD_FLOOR=4.0
ANOMALY_HEADSHOT_RATE_FLOOR=0.6
ANOMALY_HIT_RATE_FLOOR=0.55
# Minimum sample sizes required before a metric is eligible to be flagged.
ANOMALY_MIN_DEATHS=5
ANOMALY_MIN_KILLS=10
ANOMALY_MIN_HITS=40
ANOMALY_MIN_SHOTS=100
# Minimum flagged-metric population before MAD (robust) outlier scoring applies.
ANOMALY_MIN_POPULATION=5
# MAD multiplier (modified z-score cutoff) for robust outlier detection.
ANOMALY_MAD_K=3.5
