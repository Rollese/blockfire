[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://native/voice_opus/target/debug/libvoice_opus.so"
linux.release.x86_64 = "res://native/voice_opus/target/release/libvoice_opus.so"
windows.debug.x86_64 = "res://native/voice_opus/target/debug/voice_opus.dll"
windows.release.x86_64 = "res://native/voice_opus/target/release/voice_opus.dll"
