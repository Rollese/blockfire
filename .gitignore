# Godot 4+
.godot/
.import/
export.cfg
export_presets.cfg.local

# Exported builds
/build/
/export/
*.x86_64
*.pck

# OS / editor
.DS_Store
*.swp
*~

# Logs / telemetry output
*.log
/telemetry-out/
/replays/

# GDExtension build artifacts (M6 voice Opus codec — ADR-0006 — + any future escalation)
/shared/native/target/
/native/voice_opus/target/
/native/snapshot_encoder/target/
*.so
*.dll
*.dylib

# graphify derived knowledge graph (rebuild with /graphify --update)
/graphify-out/

# Live server config (per-operator; copy data/server_config.example.json). NEVER commit a
# real one: a committed rotation config would flip every gate/smoke server into the
# persistent multi-match loop and the scripts would hang waiting for server exit.
/data/server_config.json

# Local Claude Code settings (per-developer)
/.claude/settings.local.json
__pycache__/
tools/.venv-scenery/

# Superpowers brainstorm visual companion (session-local mockups)
.superpowers/
